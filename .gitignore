# ── Secrets: never commit ─────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
service-account*.json

# ── Dependencies ──────────────────────────────────────
/node_modules
/.pnp
.pnp.js

# ── Next.js / build output ────────────────────────────
/.next/
/out/
/build
*.tsbuildinfo
next-env.d.ts
.vercel

# ── Tests / logs ──────────────────────────────────────
/coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Python ────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.whl
*.egg-info/
.venv/
venv/
.pytest_cache/

# ── Editor / AI-tool scratch ──────────────────────────
.bolt/
.DS_Store
.idea/
.vscode/

# ── Local uploads & model weights ─────────────────────
/worker/**/out/
*.safetensors
*.ckpt
