# ---- Access (protects /api/*). Use the same value in the app: Settings > Access key ----
IPS_ACCESS_KEY=
# Optional: secret in webhook URLs (defaults to IPS_ACCESS_KEY)
WEBHOOK_SECRET=
# Public https URL of the deployed app (needed for provider webhooks). Vercel sets VERCEL_URL automatically.
PUBLIC_BASE_URL=

# ---- Which GPU backend runs each engine: http (default: the URL saved in Command Center) | fal | runpod ----
VIDEO_PROVIDER=http
VOICE_PROVIDER=http
MAX_SCENES=60
MAX_PARALLEL=6

# ---- Storage (Supabase). Run supabase/schema.sql once. Without these, data is kept in memory (dev only) ----
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- fal.ai ----
FAL_KEY=
FAL_VIDEO_MODEL=fal-ai/wan/v2.2-5b/image-to-video

# ---- RunPod serverless endpoints ----
RUNPOD_API_KEY=
RUNPOD_VIDEO_ENDPOINT_ID=
RUNPOD_VOICE_ENDPOINT_ID=
